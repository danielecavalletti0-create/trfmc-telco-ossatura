echo "=== 5) ANALISI LINK, ASSET, RIFERIMENTI PROIBITI ==="
python3 - <<'PY' "$BASE" "$FRONTEND" "$PUBLIC" "$OUT"
from pathlib import Path
from html.parser import HTMLParser
from urllib.parse import urlparse, unquote
import sys, re, json, html

base = Path(sys.argv[1])
frontend = Path(sys.argv[2])
public = Path(sys.argv[3])
out = Path(sys.argv[4])

class Parser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.refs = []
    def handle_starttag(self, tag, attrs):
        d = dict(attrs)
        for attr in ("href", "src", "poster", "data-src"):
            if attr in d:
                self.refs.append((tag, attr, d[attr]))

def route_for_file(p: Path):
    if public in p.parents:
        return "/" + p.relative_to(public).as_posix()
    return "/" + p.relative_to(frontend).as_posix()

def candidates_for_ref(current_file: Path, ref: str):
    ref = ref.strip()
    if not ref:
        return []

    if ref.startswith(("#", "mailto:", "tel:", "javascript:", "data:", "blob:")):
        return []

    parsed = urlparse(ref)

    if parsed.scheme in ("http", "https"):
        return []

    path = unquote(parsed.path)
    if not path:
        return []

    cands = []

    if path.startswith("/"):
        clean = path.lstrip("/")
        cands.append(public / clean)
        cands.append(frontend / clean)
    else:
        cands.append((current_file.parent / path).resolve())
        cands.append((public / path).resolve())
        cands.append((frontend / path).resolve())

    return cands

html_files = []
for p in sorted(frontend.rglob("*.html")):
    parts = set(p.parts)
    if "node_modules" in parts or "dist" in parts:
        continue
    html_files.append(p)

broken = []
external = []
refs_rows = []
for p in html_files:
    text = p.read_text(errors="ignore")
    parser = Parser()
    parser.feed(text)
    route = route_for_file(p)

    for tag, attr, ref in parser.refs:
        ref_s = ref.strip()
        parsed = urlparse(ref_s)

        if parsed.scheme in ("http", "https"):
            external.append((route, tag, attr, ref_s))
            refs_rows.append((route, tag, attr, ref_s, "EXTERNAL", ""))
            continue

        cands = candidates_for_ref(p, ref_s)
        if not cands:
            refs_rows.append((route, tag, attr, ref_s, "SKIP", ""))
            continue

        exists = [c for c in cands if c.exists()]
        if exists:
            refs_rows.append((route, tag, attr, ref_s, "OK", str(exists[0])))
        else:
            broken.append((route, tag, attr, ref_s, " | ".join(str(c) for c in cands)))
            refs_rows.append((route, tag, attr, ref_s, "BROKEN", " | ".join(str(c) for c in cands)))

# riferimenti proibiti / pericolosi
bad_patterns = [
    ("PORTA_8000", re.compile(r"127\.0\.0\.1:8000|localhost:8000")),
    ("PORTA_5174", re.compile(r"127\.0\.0\.1:5174|localhost:5174")),
    ("RUNTIME_ROOT_ASSOLUTO", re.compile(r"['\"]?/runtime/")),
    ("CDN_REMOTO", re.compile(r"https?://(?:cdn\.|unpkg\.com|cdnjs\.cloudflare\.com|jsdelivr\.net|esm\.sh|fonts\.googleapis\.com|fonts\.gstatic\.com)")),
]

bad_rows = []
scan_exts = {".html", ".js", ".css", ".ts", ".tsx", ".jsx", ".json", ".mjs"}
for p in sorted(frontend.rglob("*")):
    if not p.is_file():
        continue
    parts = set(p.parts)
    if "node_modules" in parts or "dist" in parts:
        continue
    if p.suffix.lower() not in scan_exts:
        continue
    txt = p.read_text(errors="ignore")
    rel = p.relative_to(frontend).as_posix()
    for name, rx in bad_patterns:
        for i, line in enumerate(txt.splitlines(), 1):
            if rx.search(line):
                bad_rows.append((name, rel, i, line.strip()[:300]))

(out / "refs_all.tsv").write_text(
    "page\ttag\tattr\tref\tstatus\tresolved\n" +
    "\n".join("\t".join(map(str, r)) for r in refs_rows) +
    "\n"
)

(out / "broken_assets.tsv").write_text(
    "page\ttag\tattr\tref\tcandidates\n" +
    "\n".join("\t".join(map(str, r)) for r in broken) +
    "\n"
)

(out / "external_refs.tsv").write_text(
    "page\ttag\tattr\tref\n" +
    "\n".join("\t".join(map(str, r)) for r in external) +
    "\n"
)

(out / "forbidden_refs.tsv").write_text(
    "type\tfile\tline\tcontent\n" +
    "\n".join("\t".join(map(str, r)) for r in bad_rows) +
    "\n"
)

summary = {
    "html_files": len(html_files),
    "total_refs": len(refs_rows),
    "broken_refs": len(broken),
    "external_refs": len(external),
    "forbidden_refs": len(bad_rows),
}

(out / "summary.json").write_text(json.dumps(summary, indent=2, ensure_ascii=False))

# Report HTML
def esc(x): return html.escape(str(x))

http_rows = []
http_tsv = out / "http_pages.tsv"
if http_tsv.exists():
    lines = http_tsv.read_text(errors="ignore").splitlines()
    for line in lines[1:]:
        cols = line.split("\t")
        if len(cols) >= 5:
            http_rows.append(cols[:5])

def table(headers, rows, limit=500):
    h = "".join(f"<th>{esc(x)}</th>" for x in headers)
    body = []
    for row in rows[:limit]:
        body.append("<tr>" + "".join(f"<td>{esc(x)}</td>" for x in row) + "</tr>")
    return f"<table><thead><tr>{h}</tr></thead><tbody>{''.join(body)}</tbody></table>"

bad_http = [r for r in http_rows if len(r) > 1 and r[1] != "200"]
broken_rows = list(broken)
forbidden_rows = list(bad_rows)

report = f"""<!doctype html>
