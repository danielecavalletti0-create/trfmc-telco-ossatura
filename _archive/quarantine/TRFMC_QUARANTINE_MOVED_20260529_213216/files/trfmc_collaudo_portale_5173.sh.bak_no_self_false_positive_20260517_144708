  background: rgba(255,255,255,.08);
  padding: 2px 5px;
  border-radius: 5px;
}}
a {{ color: #9ed0ff; }}
</style>
</head>
<body>
<header>
  <h1>TRFMC — Collaudo Portale 5173</h1>
  <div>Report generato da <code>trfmc_collaudo_portale_5173.sh</code></div>
  <div>Portale ufficiale: <a href="http://127.0.0.1:5173">http://127.0.0.1:5173</a></div>
</header>
<main>
  <div class="grid">
    <div class="card"><div>HTML</div><div class="kpi">{summary["html_files"]}</div></div>
    <div class="card"><div>Reference totali</div><div class="kpi">{summary["total_refs"]}</div></div>
    <div class="card"><div>Asset/link rotti</div><div class="kpi {'ok' if summary["broken_refs"] == 0 else 'bad'}">{summary["broken_refs"]}</div></div>
    <div class="card"><div>Reference esterni</div><div class="kpi {'ok' if summary["external_refs"] == 0 else 'warn'}">{summary["external_refs"]}</div></div>
    <div class="card"><div>Riferimenti proibiti</div><div class="kpi {'ok' if summary["forbidden_refs"] == 0 else 'bad'}">{summary["forbidden_refs"]}</div></div>
  </div>

  <h2>Pagine HTTP non OK</h2>
  {table(["route", "status", "bytes", "time", "file"], bad_http) if bad_http else '<p class="ok">Tutte le pagine censite rispondono HTTP 200.</p>'}

  <h2>Asset/link interni rotti</h2>
  {table(["page", "tag", "attr", "ref", "candidates"], broken_rows) if broken_rows else '<p class="ok">Nessun asset/link interno rotto rilevato.</p>'}

  <h2>Riferimenti proibiti o da bonificare</h2>
  {table(["type", "file", "line", "content"], forbidden_rows) if forbidden_rows else '<p class="ok">Nessun riferimento proibito rilevato.</p>'}

  <h2>Tutte le pagine testate</h2>
  {table(["route", "status", "bytes", "time", "file"], http_rows)}
</main>
</body>
</html>
"""

(out / "trfmc_collaudo_report.html").write_text(report)
(public / "trfmc_collaudo_report.html").write_text(report)

print(json.dumps(summary, indent=2, ensure_ascii=False))
PY

